---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  // Shell command shown above the heading, e.g. "ls -lt posts/".
  command: string;
  heading: string;
  intro?: string;
}

const { title, description, command, heading, intro } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <p class="mb-3 font-mono text-sm text-muted">
    <span class="text-accent">$</span>
    {command}
  </p>
  <h1 class="mb-3 font-mono text-3xl font-bold tracking-tight md:text-5xl">
    {heading}<span class="text-accent">_</span>
  </h1>
  {intro && <p class="mb-10 max-w-2xl text-muted">{intro}</p>}
  <slot name="filters" />
  <slot />
</BaseLayout>

---
const today = new Date();
---

<footer class="border-t border-line">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-6 py-8 font-mono text-xs text-dim"
  >
    <span>
      &copy; {today.getFullYear()} Soyeong Choi ·
      <a
        href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.ko"
        target="_blank"
        rel="license noopener"
        class="underline-offset-4 hover:text-fg hover:underline">CC BY-NC-SA 4.0</a
      >
    </span>
    <span class="flex gap-4">
      <a href="/rss.xml" class="hover:text-accent">rss</a>
      <a
        href="https://github.com/so0choi"
        target="_blank"
        rel="noopener"
        class="hover:text-accent">github</a
      >
      <a
        href="https://www.instagram.com/so02hi"
        target="_blank"
        rel="noopener"
        class="hover:text-accent">instagram</a
      >
    </span>
  </div>
</footer>

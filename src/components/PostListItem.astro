---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate } = post.data;
const category = post.id.split("/")[0];
const isoDate = pubDate.toISOString().slice(0, 10);
---

<li class="border-b border-line">
  <a
    href={`/blog/${post.id}/`}
    class="group flex flex-wrap gap-x-8 gap-y-2 px-1 py-6"
  >
    <time
      datetime={pubDate.toISOString()}
      class="shrink-0 basis-28 pt-1 font-mono text-[13px] text-dim">{isoDate}</time
    >
    <div class="flex min-w-0 flex-[999_1_28rem] flex-col gap-2">
      <h2
        class="m-0 text-lg leading-snug font-bold text-fg transition-colors group-hover:text-accent md:text-xl"
      >
        {title}
      </h2>
      {
        description && (
          <p class="m-0 line-clamp-2 text-[15px] leading-relaxed text-muted">
            {description}
          </p>
        )
      }
      <span class="font-mono text-xs text-accent">[{category}]</span>
    </div>
  </a>
</li>

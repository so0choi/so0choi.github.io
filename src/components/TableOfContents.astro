---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  // "inline": collapsible block above the body; "sidebar": sticky side nav.
  variant: "inline" | "sidebar";
}

const { headings, variant } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length >= 2 && variant === "inline" && (
      <details class="mb-10 rounded border border-line px-4 py-3 font-mono text-sm">
        <summary class="cursor-pointer text-muted">
          <span class="text-accent">$</span> toc
        </summary>
        <ol class="mt-3 flex list-none flex-col gap-1.5 p-0">
          {items.map((h) => (
            <li class:list={[h.depth === 3 && "pl-4"]}>
              <a href={`#${h.slug}`} class="text-muted hover:text-fg">
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
  )
}
{
  items.length >= 2 && variant === "sidebar" && (
      <nav
        aria-label="목차"
        class="sticky top-8 max-h-[calc(100vh-4rem)] overflow-y-auto font-mono text-[13px]"
      >
        <p class="mb-3 text-dim">## contents</p>
        <ol class="m-0 flex list-none flex-col gap-2 border-l border-line p-0">
          {items.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                data-toc-link={h.slug}
                class:list={[
                  "-ml-px block border-l border-transparent leading-snug text-dim transition-colors hover:text-fg",
                  h.depth === 3 ? "pl-7" : "pl-4",
                ]}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
  )
}

<script>
  // Highlight the section currently in view.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")].map(
      (a) => [a.dataset.tocLink!, a],
    ),
  );
  if (links.size) {
    const setActive = (id: string) => {
      for (const [slug, a] of links) a.classList.toggle("toc-active", slug === id);
    };
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length) setActive(visible[0].target.id);
      },
      { rootMargin: "0px 0px -70% 0px" },
    );
    for (const id of links.keys()) {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    }
  }
</script>

<style>
  :global(.toc-active) {
    color: var(--accent) !important;
    border-left-color: var(--accent) !important;
  }
</style>

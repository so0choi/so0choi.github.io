---
import HeaderLink from "./HeaderLink.astro";
import InstaIcon from "../assets/icons/insta.svg";
---

<header class="border-b border-line">
  <nav
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-6 py-3 font-mono text-sm"
  >
    <a href="/" class="text-fg">
      <span class="text-accent">~/</span>so0choi<span class="text-muted"
        >.blog</span
      >
    </a>
    <div class="flex items-center gap-5">
      <HeaderLink href="/">./about</HeaderLink>
      <HeaderLink href="/blog">./blog</HeaderLink>
      <HeaderLink href="/tags">./tags</HeaderLink>
      <HeaderLink href="/search">./search</HeaderLink>
      <span class="hidden h-4 w-px bg-line md:block" aria-hidden="true"></span>
      <div class="hidden items-center gap-4 md:flex">
        <a
          href="https://github.com/so0choi"
          target="_blank"
          rel="noopener"
          class="text-muted transition-colors hover:text-fg"
        >
          <span class="sr-only">GitHub</span>
          <svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
            ><path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path></svg
          >
        </a>
        <a
          href="https://www.linkedin.com/in/so0choi/"
          target="_blank"
          rel="noopener"
          class="text-muted transition-colors hover:text-fg"
        >
          <span class="sr-only">LinkedIn</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"
            ><path
              fill="currentColor"
              d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
            ></path></svg
          >
        </a>
        <a
          href="https://www.instagram.com/so02hi"
          target="_blank"
          rel="noopener"
          class="text-muted transition-colors hover:text-fg [&_path]:fill-current"
        >
          <span class="sr-only">Instagram</span>
          <InstaIcon width={18} height={18} aria-hidden="true" />
        </a>
      </div>
    </div>
  </nav>
</header>

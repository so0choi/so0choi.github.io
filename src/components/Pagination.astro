---
interface Props {
  current: number;
  last: number;
}

const { current, last } = Astro.props;
// Page 1 lives at /blog, the rest at /blog/page/N.
const href = (n: number) => (n === 1 ? "/blog" : `/blog/page/${n}`);
const pages = Array.from({ length: last }, (_, i) => i + 1);
---

{
  last > 1 && (
    <nav
      aria-label="Pagination"
      class="mt-10 flex flex-wrap items-center gap-1 font-mono text-sm"
    >
      <span class="mr-2 text-dim">page</span>
      {pages.map((n) => (
        <a
          href={href(n)}
          aria-current={n === current ? "page" : undefined}
          class:list={[
            "min-w-8 rounded px-2 py-1 text-center",
            n === current
              ? "bg-fg font-bold text-bg"
              : "text-muted hover:bg-surface hover:text-fg",
          ]}
        >
          {n}
        </a>
      ))}
      <span class="ml-auto flex gap-4">
        {current > 1 && (
          <a href={href(current - 1)} class="text-muted hover:text-fg">
            &lt;-- prev
          </a>
        )}
        {current < last && (
          <a href={href(current + 1)} class="text-accent hover:text-accent-dark">
            next --&gt;
          </a>
        )}
      </span>
    </nav>
  )
}

---
import Search from "astro-pagefind/components/Search";
import PostListLayout from "../layouts/PostListLayout.astro";
---

<PostListLayout title="Search" command="grep -ri" heading="search">
  <Search
    id="search"
    className="pagefind-ui"
    uiOptions={{
      showImages: false,
    }}
  />
</PostListLayout>

<style is:global>
  .pagefind-ui {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--line);
    --pagefind-ui-tag: var(--surface);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: "Pretendard", system-ui, sans-serif;
  }
  .pagefind-ui .pagefind-ui__search-input {
    font-family: var(--font-mono-stack);
  }
  .pagefind-ui .pagefind-ui__result-link {
    color: var(--fg);
  }
  .pagefind-ui mark {
    background: transparent;
    color: var(--accent);
  }
</style>

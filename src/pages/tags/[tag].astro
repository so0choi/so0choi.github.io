---
import { getCollection, type CollectionEntry } from "astro:content";
import PostListItem from "@components/PostListItem.astro";
import PostListLayout from "../../layouts/PostListLayout.astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const tags = Array.from(new Set(allPosts.flatMap((p) => p.data.tags ?? [])));

  return tags.map((tag) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.tags?.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    const slug = encodeURIComponent(tag);
    return {
      params: { tag: slug },
      props: { tag, posts: filteredPosts },
    };
  });
}

type Props = {
  tag: string;
  posts: CollectionEntry<"blog">[];
};

const { tag, posts } = Astro.props as Props;
---

<PostListLayout
  title={`Tag: ${tag}`}
  command={`grep -rl "#${tag}" posts/`}
  heading={`#${tag}`}
  intro={`${posts.length} posts tagged with ${tag}.`}
>
  <ul class="m-0 list-none border-t border-line p-0">
    {posts.map((post) => <PostListItem post={post} />)}
  </ul>
  <a href="/tags" class="mt-10 inline-block font-mono text-sm text-muted hover:text-fg">&lt;-- all tags</a>
</PostListLayout>

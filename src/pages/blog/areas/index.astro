---
import { SITE_DESCRIPTION } from "../../../consts";
import PostListLayout from "../../../layouts/PostListLayout.astro";
import { getCategories } from "../../../utils/posts";

const categories = await getCategories();
---

<PostListLayout
  title="Categories"
  description={SITE_DESCRIPTION}
  command="ls posts/"
  heading="categories"
>
  <ul class="m-0 grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-2 md:grid-cols-3">
    {
      categories.map((c) => (
        <li>
          <a
            href={`/blog/areas/${c.name}`}
            class="flex items-baseline justify-between rounded border border-line px-4 py-3 font-mono text-sm transition-colors hover:border-accent hover:text-accent"
          >
            <span>{c.name}/</span>
            <span class="text-dim">{c.count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</PostListLayout>

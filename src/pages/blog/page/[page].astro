---
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import CategoryChips from "@components/CategoryChips.astro";
import Pagination from "@components/Pagination.astro";
import PostListItem from "@components/PostListItem.astro";
import { POSTS_PER_PAGE, SITE_DESCRIPTION, SITE_TITLE } from "../../../consts";
import PostListLayout from "../../../layouts/PostListLayout.astro";
import { getSortedPosts } from "../../../utils/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getSortedPosts();
  // Page 1 is rendered by /blog itself.
  return paginate(posts, { pageSize: POSTS_PER_PAGE }).filter(
    (p) => p.params.page !== "1",
  );
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<CollectionEntry<"blog">> };
---

<PostListLayout
  title={`${SITE_TITLE} · page ${page.currentPage}`}
  description={SITE_DESCRIPTION}
  command={`ls -lt posts/ | sed -n ${page.start + 1},${page.end + 1}p`}
  heading={SITE_TITLE}
>
  <CategoryChips slot="filters" total={page.total} />
  <ul class="m-0 list-none border-t border-line p-0">
    {page.data.map((post) => <PostListItem post={post} />)}
  </ul>
  <Pagination current={page.currentPage} last={page.lastPage} />
</PostListLayout>

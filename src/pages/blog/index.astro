---
import CategoryChips from "@components/CategoryChips.astro";
import Pagination from "@components/Pagination.astro";
import PostListItem from "@components/PostListItem.astro";
import { POSTS_PER_PAGE, SITE_DESCRIPTION, SITE_INTRO, SITE_TITLE } from "../../consts";
import PostListLayout from "../../layouts/PostListLayout.astro";
import { getSortedPosts } from "../../utils/posts";

const posts = await getSortedPosts();
const lastPage = Math.ceil(posts.length / POSTS_PER_PAGE);
---

<PostListLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  command="ls -lt posts/ | head"
  heading={SITE_TITLE}
  intro={`${SITE_INTRO} ${posts.length} posts.`}
>
  <CategoryChips slot="filters" total={posts.length} />
  <ul class="m-0 list-none border-t border-line p-0">
    {posts.slice(0, POSTS_PER_PAGE).map((post) => <PostListItem post={post} />)}
  </ul>
  <Pagination current={1} last={lastPage} />
</PostListLayout>

---
import { getCollection } from "astro:content";
import Pagination from "@components/Pagination.astro";
import PostListItem from "@components/PostListItem.astro";
import { POSTS_PER_PAGE, SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

import PostListLayout from "../../layouts/PostListLayout.astro";
const all = await getCollection("blog");
const posts = all.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const lastPage = Math.ceil(posts.length / POSTS_PER_PAGE);
---

<PostListLayout
  description={SITE_DESCRIPTION}
  title={SITE_TITLE}
>
    <a href="/blog/areas" slot="category-btn">
        <button
                class="h-fit cursor-pointer rounded-xl bg-gray-200 p-2 text-xs text-gray-500 transition-all hover:bg-gray-300"
        >Categories ></button
        >
    </a>
  <div class="mt-5">
    <span class="text-sm text-gray-400">LATEST</span>
    <ul class="m-0 p-0">
      {posts.slice(0, POSTS_PER_PAGE).map((post) => <PostListItem post={post} />)}
    </ul>
    <Pagination current={1} last={lastPage} />
  </div>
</PostListLayout>
